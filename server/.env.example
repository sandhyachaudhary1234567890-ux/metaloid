# ═══════════════════════════════════════════════════════════════════════
# METALOID gateway — server-only environment
#
# Copy to `server/.env`. NOTHING in this file may ever be exposed to a
# browser, an Android APK, or a public repository.
#
# After editing, check it before deploying — this costs nothing and reports
# exactly what is missing, with no network access:
#
#   node server/tools/preflight.mjs --env server/.env --production
# ═══════════════════════════════════════════════════════════════════════

# ── listen / CORS ──────────────────────────────────────────────────────
PORT=8787
# 127.0.0.1 keeps an auth-less dev gateway off the LAN. Use 0.0.0.0 only
# when you need phone testing, and never expose this port to the internet.
BIND_HOST=127.0.0.1
# Comma-separated allow-list. Never '*' in production.
ALLOW_ORIGINS=http://localhost:5173,https://your-site.example
# 'production' disables the anonymous local-demo fallback outright. Hosted
# platforms are detected automatically (VERCEL), but setting this explicitly
# means a deployment never depends on remembering to configure anything.
# METALOID_MODE=production

# ── model provider ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Optional: pin a preferred model (failover still applies)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: point at a compatible proxy or the local fake provider
# OPENROUTER_BASE=http://127.0.0.1:9911/api/v1
# Sent to the provider as HTTP-Referer
# PUBLIC_APP_URL=https://your-site.example

NVIDIA_API_KEY=
NVIDIA_ENABLED=false

# ── data driver ────────────────────────────────────────────────────────
# The switch is SUPABASE_DB, and it has to be set explicitly: nothing is
# auto-detected. Both halves are required or the gateway uses the local JSON
# store under METALOID_DATA_DIR, which does not survive a serverless instance.
#
#   SUPABASE_DB=supabase     → Postgres + RLS (production)
#   SUPABASE_DB=             → file-backed store (local dev / self-host)
SUPABASE_DB=supabase
# Connect → Transaction pooler. Without it the driver above cannot connect and
# falls back to the local store (it logs a warning when that happens).
SUPABASE_DB_POOL_URL=postgresql://postgres.<ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
# Cap pooled connections per instance (default 5). Serverless scales to many
# instances, and an uncapped pool per instance exhausts the pooler.
# METALOID_PG_POOL_MAX=5

# ── Supabase (server-only) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Bypasses RLS. Server-side only: account deletion and private-object signing.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVICE_ROLE_KEY
# Public anon key — used to build user-scoped clients so RLS applies as the user
SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY

# ── JWT verification (choose ONE) ──────────────────────────────────────
# Preferred — asymmetric signing (Supabase's current default):
#   Project Settings → API → JWT Settings → JWKS URL
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Legacy — only if the project still signs with the shared HS256 secret
# SUPABASE_JWT_SECRET=REPLACE_ME_JWT_SECRET

# ── provider-secret encryption (REQUIRED to store user API keys) ───────
# 32 random bytes, base64. Generate:  openssl rand -base64 32
# Format: "<keyId>:<base64>,<keyId>:<base64>"  — several keys = rotation.
#   METALOID_ENCRYPTION_ACTIVE picks which one encrypts new writes; every
#   listed key can still decrypt, so rotation is a config change + backfill.
METALOID_ENCRYPTION_KEYS=k1:REPLACE_WITH_32_BYTES_BASE64
# METALOID_ENCRYPTION_ACTIVE=k1

# Master key for the LEGACY file-mode vault (core/crypto.js), used by the older
# credentialVault surface. Unlike the keyring above, this one has a fallback:
# when it is unset the module generates a RANDOM key per boot, and credentials
# written through it stop decrypting after a restart. The /api/v1 credential
# path uses METALOID_ENCRYPTION_KEYS instead — set both in production.
#   openssl rand -base64 32
# METALOID_CREDENTIAL_KEY=REPLACE_WITH_32_BYTES_BASE64

# ── optional ───────────────────────────────────────────────────────────
# GitHub token for repo-oriented skills
# GITHUB_TOKEN=
