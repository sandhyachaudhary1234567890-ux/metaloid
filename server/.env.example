# ═══════════════════════════════════════════════════════════════════════
# METALOID gateway — server-only environment
#
# Copy to `server/.env`. NOTHING in this file may ever be exposed to a
# browser, an Android APK, or a public repository.
# ═══════════════════════════════════════════════════════════════════════

# ── listen / CORS ──────────────────────────────────────────────────────
PORT=8787
# 127.0.0.1 keeps an auth-less dev gateway off the LAN. Use 0.0.0.0 only
# when you need phone testing, and never expose this port to the internet.
BIND_HOST=127.0.0.1
# Comma-separated allow-list. Never '*' in production.
ALLOW_ORIGINS=http://localhost:5173,https://your-site.example

# ── model provider ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
# Optional: pin a preferred model (failover still applies)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: point at a compatible proxy or the local fake provider
# OPENROUTER_BASE=http://127.0.0.1:9911/api/v1
# Sent to the provider as HTTP-Referer
# PUBLIC_APP_URL=https://your-site.example

NVIDIA_API_KEY=
NVIDIA_ENABLED=false

# ── data driver ────────────────────────────────────────────────────────
# `local`     → file-backed store (demo/sandbox/offline; no accounts)
# `supabase`  → Postgres + RLS (production)
# Leave unset and the gateway picks Supabase when SUPABASE_URL + service key
# are present, otherwise local. The choice is reported by /api/health.
# METALOID_DATA_DRIVER=supabase

# ── Supabase (server-only) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Bypasses RLS. Server-side only: account deletion and private-object signing.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SERVICE_ROLE_KEY
# Public anon key — used to build user-scoped clients so RLS applies as the user
SUPABASE_ANON_KEY=REPLACE_ME_ANON_KEY

# ── JWT verification (choose ONE) ──────────────────────────────────────
# Preferred — asymmetric signing (Supabase's current default):
#   Project Settings → API → JWT Settings → JWKS URL
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Legacy — only if the project still signs with the shared HS256 secret
# SUPABASE_JWT_SECRET=REPLACE_ME_JWT_SECRET

# ── provider-secret encryption (REQUIRED to store user API keys) ───────
# 32 random bytes, base64. Generate:  openssl rand -base64 32
# Format: "<keyId>:<base64>,<keyId>:<base64>"  — several keys = rotation.
#   METALOID_ENCRYPTION_ACTIVE picks which one encrypts new writes; every
#   listed key can still decrypt, so rotation is a config change + backfill.
METALOID_ENCRYPTION_KEYS=k1:REPLACE_WITH_32_BYTES_BASE64
# METALOID_ENCRYPTION_ACTIVE=k1

# ── optional ───────────────────────────────────────────────────────────
# GitHub token for repo-oriented skills
# GITHUB_TOKEN=
