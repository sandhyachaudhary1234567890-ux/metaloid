{
  "name": "metaloid-gateway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "METALOID edge/API gateway — model router, agent skills, OSINT orchestration. Keys stay here, never in the frontend.",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:watch": "node --test --watch \"tests/*.test.mjs\"",
    "fake:provider": "node tests/fake-provider.mjs --port 9911 --scenario ok"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "selfsigned": "^5.5.0"
  }
}
