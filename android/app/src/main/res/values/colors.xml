<?xml version="1.0" encoding="utf-8"?>
<!--
  Brand colours for the *platform* layer only.

  Compose draws the whole app and owns the real design tokens
  (core/designsystem/Tokens.kt, generated from src/design/tokens.ts in the web
  client so both clients cannot drift). These values exist so the frames before
  Compose draws — the window background, the Android 12+ splash — are already
  MetaIoid rather than white.
-->
<resources>
    <!-- Warm Obsidian: the dark page. Never pure black. -->
    <color name="brand_obsidian">#0E0E0D</color>
    <!-- Warm Paper: the light page. Never pure white. -->
    <color name="brand_paper">#FAF8F4</color>
    <!-- Launch/splash surface is intentionally pure white behind the original black mark. -->
    <color name="brand_splash_white">#FFFFFF</color>
    <!-- MetaIoid Jade: the single accent. -->
    <color name="brand_jade">#5CC79A</color>
    <!--
      The adaptive-icon plate. White, because the mark is black ink: the brand
      asset (public/brand/metaloid-mark.png) is a black glyph on transparency,
      so any dark plate makes the launcher icon a black shape on a black square.
      This is the original pairing — black mark, white ground — and the only one
      that stays legible on a light or a dark launcher.
    -->
    <color name="brand_icon_background">#FFFFFF</color>
</resources>
