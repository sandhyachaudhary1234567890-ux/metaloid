<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores may leave the device through a backup or a transfer.

  The app already sets allowBackup="false"; these rules are the belt to that
  brace for Android 12+, where a device-to-device transfer could otherwise copy
  app files. The excluded paths are the ones that hold the session: the
  encrypted token store, the read cache and the draft store.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
