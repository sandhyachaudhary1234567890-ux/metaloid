<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network policy.

  A developer points the app at a gateway running on their machine
  (http://10.0.2.2:8787 from the emulator, or http://192.168.x.x:8787 from a
  phone on the same LAN). Those hosts are plain HTTP, so cleartext must be
  permitted in the debug variant — and only there. The release variant keeps
  the strict policy in src/main/res/xml/network_security_config.xml, and the
  release checklist verifies it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
