  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "outDir": ".tsbuild-temp",
    "declarationDir": ".tsbuild-temp"
  },
  "include": ["vite.config.ts"]
}
